rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /suggested_rules/{ruleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /errors/{errorId} {
      allow read: if false;
      allow write: if request.auth != null;
    }
  }
}
