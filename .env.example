# JobApplier Local Development Configuration

# Toggle detailed debugger logging in the console (true/false)
DEBUG_MODE=false

# Override storage backends with in-memory simulation (true/false)
MOCK_STORAGE=false

# Auto-approve critical fields in developer mode (WARNING: Do not use in production) (true/false)
BYPASS_CONFIRMATIONS=false


# Firebase Cloud Rules Sync Configuration
# Replace these placeholders with your actual project credentials from the Firebase Web App console.
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-auth-domain
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
